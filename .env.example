HA_URL=http://ha.example.internal:8123
HA_TOKEN=your-long-lived-access-token-here
HA_TRANSPORT=stdio
HA_HTTP_PORT=8100
HA_REQUEST_TIMEOUT=10.0

# --- WebSocket / person (registry-config) write path ---
# WS URL is derived from HA_URL (http->ws, https->wss, + /api/websocket) unless set.
# HA_WS_URL=ws://192.168.1.10:8123/api/websocket
# Registry/person mutation needs an ADMIN token. Reuses HA_TOKEN unless a separate,
# narrowly-scoped admin token is provided here (recommended).
# HA_WS_TOKEN=your-admin-long-lived-access-token-here
# HA_WS_TIMEOUT=15.0
# Fail-closed kill switch for person create/update/delete (reads always allowed).
# Defaults OFF — set to true only when person writes are actually wanted.
HA_PERSON_WRITES_ENABLED=false
# Fail-closed kill switch for entity/device/area registry writes (reads always
# allowed). Defaults OFF — a registry change can break references system-wide.
HA_REGISTRY_WRITE_ENABLED=false
# Second gate for ha_delete_config_entry, required ON TOP of the write gate above.
# Deleting a config entry removes an integration AND every entity/device it owns.
# Even with both gates on, the delete stays a dry run until confirm=True.
HA_REGISTRY_DESTRUCTIVE_ENABLED=false

# --- Cloudflare Access JWT validation (HTTP transport only) ---
# With HA_TRANSPORT=http and HA_REQUIRE_ACCESS_JWT on (the default), startup fails
# unless the AUD and team domain are set. The email allowlist defaults to empty.
# HA_REQUIRE_ACCESS_JWT=true
# HA_ACCESS_AUD=<your-access-aud>
# HA_ACCESS_TEAM_DOMAIN=<your-team>.cloudflareaccess.com
# HA_ACCESS_ALLOWED_EMAILS=you@example.com,alt@example.com
